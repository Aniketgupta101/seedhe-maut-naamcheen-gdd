; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes in []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Naamcheen"
config/description="Seedhe Maut – Naamcheen Beat-Em-Up"
config/version="0.1.0"
run/main_scene="res://scenes/stages/stage_1.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://assets/sprites/icon.png"

[autoload]

GameManager="*res://scripts/autoloads/game_manager.gd"
ComboManager="*res://scripts/autoloads/combo_manager.gd"
AudioManager="*res://scripts/autoloads/audio_manager.gd"
ScreenEffects="*res://scripts/autoloads/screen_effects.gd"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/resizable=true
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

